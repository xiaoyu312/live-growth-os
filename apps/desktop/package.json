{
  "name": "@live-growth/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Local live data collection pilot",
  "author": "xiaoyu312",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test:unit": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.livegrowth.pilot",
    "productName": "LiveGrowthPilot",
    "npmRebuild": false,
    "asar": true,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "app-preset.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "LiveGrowthPilot-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "LiveGrowthPilot-${version}-${arch}.${ext}"
    }
  },
  "license": "MIT"
}
